<resources>
    <!-- Android 12+ splash is a color + a circular icon. Hide the icon and match the
         sky so the system splash is a flat sky, then MainActivity shows the 3D poster. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <item name="android:textColor">#000000</item>
        <item name="android:windowBackground">@drawable/boot_splash</item>
        <item name="android:windowSplashScreenBackground">@color/splash_sky</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/boot_splash_icon_hidden</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
</resources>
